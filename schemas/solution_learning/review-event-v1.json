{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra://solution-learning/review-event-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "source_event_sha", "operation", "actor_kind", "label_scope", "source_revision", "before_sha", "after_sha", "payload", "applied_at"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_event_sha": {"$ref": "#/$defs/sha256"},
    "operation": {"type": "string", "minLength": 1},
    "actor_kind": {"enum": ["model", "human", "agent", "legacy_unknown", "test_fixture"]},
    "label_scope": {"enum": ["content_match", "crop_bounds", "unit_boundary", "answer_cell", "number_mapping"]},
    "source_revision": {"type": "integer", "minimum": 1},
    "before_sha": {"$ref": "#/$defs/sha256"},
    "after_sha": {"$ref": "#/$defs/sha256"},
    "payload": {"type": "object"},
    "applied_at": {"type": "string", "format": "date-time"},
    "supersedes_event_id": {"type": ["string", "null"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
