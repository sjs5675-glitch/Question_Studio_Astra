{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "asset_id",
    "candidate_role",
    "repairable",
    "parts",
    "confidence",
    "rationale"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "candidate_role": {
      "type": "string",
      "enum": ["quick_answer", "detailed_solution", "mixed"]
    },
    "repairable": {"type": "boolean"},
    "parts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["solution_pdf_index", "bbox", "order"],
        "properties": {
          "solution_pdf_index": {"type": "integer", "minimum": 0},
          "bbox": {"$ref": "#/$defs/bbox"},
          "order": {"type": "integer", "minimum": 0}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string"}
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "integer", "minimum": 0, "maximum": 1000}
    }
  }
}
