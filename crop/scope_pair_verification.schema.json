{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scope_pair_verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "candidate_ids",
    "candidate_role",
    "problem_scope_id",
    "solution_scope_id",
    "decision",
    "same_question",
    "scope_episode_match",
    "hierarchy_scope_match",
    "parent_number_match",
    "subquestion_match",
    "monotonic_order_match",
    "fingerprint_match",
    "candidate_crop_complete",
    "target_identifier_visible",
    "target_answer_visible",
    "first_line_complete",
    "last_line_complete",
    "neighbor_entry_absent",
    "next_question_absent",
    "explicit_answer_conflict",
    "answer_cell_geometry",
    "current_source_corroboration",
    "heading_context_match",
    "continuation_context_match",
    "evidence",
    "review_reasons",
    "confidence"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "candidate_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_role": {
      "type": "string",
      "enum": ["quick_answer", "detailed_solution"]
    },
    "problem_scope_id": {"type": "string", "minLength": 1},
    "solution_scope_id": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["verified", "review", "wrong_link", "conflict"]},
    "same_question": {"type": "string", "enum": ["yes", "no", "uncertain"]},
    "scope_episode_match": {"$ref": "#/$defs/comparison_state"},
    "hierarchy_scope_match": {"$ref": "#/$defs/comparison_state"},
    "parent_number_match": {"$ref": "#/$defs/comparison_state"},
    "subquestion_match": {"$ref": "#/$defs/comparison_state"},
    "monotonic_order_match": {"$ref": "#/$defs/comparison_state"},
    "fingerprint_match": {"$ref": "#/$defs/comparison_state"},
    "candidate_crop_complete": {"type": "boolean"},
    "target_identifier_visible": {"type": "boolean"},
    "target_answer_visible": {"type": "string", "enum": ["yes", "no", "not_applicable"]},
    "first_line_complete": {"type": "boolean"},
    "last_line_complete": {"type": "boolean"},
    "neighbor_entry_absent": {"type": "boolean"},
    "next_question_absent": {"type": "boolean"},
    "explicit_answer_conflict": {"type": "boolean"},
    "answer_cell_geometry": {
      "type": "string",
      "enum": ["isolated", "unseparated", "unknown", "not_applicable"]
    },
    "current_source_corroboration": {
      "anyOf": [
        {"$ref": "#/$defs/comparison_state"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_reference"}
        }
      ]
    },
    "heading_context_match": {"$ref": "#/$defs/comparison_state"},
    "continuation_context_match": {"$ref": "#/$defs/comparison_state"},
    "evidence": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string"},
          {"$ref": "#/$defs/source_evidence"}
        ]
      }
    },
    "review_reasons": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "candidate_role": {"const": "quick_answer"},
          "decision": {"const": "verified"}
        },
        "required": ["candidate_role", "decision"]
      },
      "then": {
        "properties": {
          "same_question": {"const": "yes"},
          "scope_episode_match": {"const": "match"},
          "hierarchy_scope_match": {"const": "match"},
          "parent_number_match": {"const": "match"},
          "subquestion_match": {"enum": ["match", "not_applicable"]},
          "monotonic_order_match": {"const": "match"},
          "answer_cell_geometry": {"const": "isolated"},
          "current_source_corroboration": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/source_reference"}
          },
          "candidate_crop_complete": {"const": true},
          "target_identifier_visible": {"const": true},
          "target_answer_visible": {"const": "yes"},
          "neighbor_entry_absent": {"const": true},
          "next_question_absent": {"const": true},
          "explicit_answer_conflict": {"const": false},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/source_evidence"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate_role": {"const": "detailed_solution"},
          "decision": {"const": "verified"}
        },
        "required": ["candidate_role", "decision"]
      },
      "then": {
        "properties": {
          "same_question": {"const": "yes"},
          "scope_episode_match": {"const": "match"},
          "hierarchy_scope_match": {"const": "match"},
          "parent_number_match": {"const": "match"},
          "subquestion_match": {"enum": ["match", "not_applicable"]},
          "monotonic_order_match": {"const": "match"},
          "fingerprint_match": {"const": "match"},
          "answer_cell_geometry": {"const": "not_applicable"},
          "current_source_corroboration": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/source_reference"}
          },
          "heading_context_match": {"const": "match"},
          "continuation_context_match": {
            "enum": ["match", "not_applicable"]
          },
          "candidate_crop_complete": {"const": true},
          "target_identifier_visible": {"const": true},
          "target_answer_visible": {
            "enum": ["yes", "not_applicable"]
          },
          "first_line_complete": {"const": true},
          "last_line_complete": {"const": true},
          "neighbor_entry_absent": {"const": true},
          "next_question_absent": {"const": true},
          "explicit_answer_conflict": {"const": false},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/source_evidence"}
          }
        }
      }
    }
  ],
  "$defs": {
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_reference_index", "observation"],
      "properties": {
        "kind": {"type": "string", "const": "source_visible"},
        "source_reference_index": {"type": "integer", "minimum": 0},
        "observation": {"type": "string", "minLength": 1}
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_role",
        "source_sha256",
        "image_sha256",
        "pdf_page",
        "target_number",
        "target_bbox"
      ],
      "properties": {
        "source_role": {
          "type": "string",
          "enum": [
            "current_problem",
            "current_detailed_solution",
            "ordered_source_context"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pdf_page": {"type": "integer", "minimum": 1},
        "target_number": {"type": "string", "minLength": 1},
        "target_bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "integer", "minimum": 0, "maximum": 1000}
        }
      }
    },
    "comparison_state": {
      "type": "string",
      "enum": ["match", "mismatch", "unknown", "not_applicable"]
    }
  }
}
