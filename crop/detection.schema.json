{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["page_type", "layout", "questions", "ignored_regions", "warnings"],
  "properties": {
    "page_type": {
      "type": "string",
      "enum": [
        "problem",
        "mixed_problem_and_concept",
        "problem_with_inline_solution",
        "shared_material_only",
        "excluded_drill",
        "concept_only",
        "solution",
        "answer_key",
        "cover",
        "table_of_contents",
        "advertisement",
        "blank",
        "other"
      ]
    },
    "layout": {
      "type": "string",
      "enum": ["single_column", "two_columns", "mixed", "non_problem"]
    },
    "questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    },
    "ignored_regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/ignored_region"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "integer", "minimum": 0, "maximum": 1000}
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_offset", "role", "bbox"],
      "properties": {
        "page_offset": {"type": "integer", "minimum": -1, "maximum": 1},
        "role": {
          "type": "string",
          "enum": [
            "shared_material",
            "instruction",
            "main_number",
            "stem",
            "figure_or_table",
            "choices",
            "response_area",
            "sidecar_hint",
            "subquestion",
            "continuation"
          ]
        },
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    "subquestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "answer_type", "parts", "confidence"],
      "properties": {
        "label": {"type": "string"},
        "answer_type": {"$ref": "#/$defs/answer_type"},
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/part"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_id",
        "printed_number",
        "number_bbox",
        "kind",
        "answer_type",
        "group_label",
        "shared_context_parts",
        "main_parts",
        "subquestions",
        "starts_on_previous_page",
        "continues_next_page",
        "confidence"
      ],
      "properties": {
        "local_id": {"type": "string", "minLength": 1},
        "printed_number": {"type": "string"},
        "number_bbox": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {"type": "integer", "minimum": 0, "maximum": 1000}
        },
        "kind": {
          "type": "string",
          "enum": [
            "standalone",
            "shared_group_member",
            "parent_with_subquestions",
            "continuation"
          ]
        },
        "answer_type": {"$ref": "#/$defs/answer_type"},
        "group_label": {"type": ["string", "null"]},
        "shared_context_parts": {
          "type": "array",
          "items": {"$ref": "#/$defs/part"}
        },
        "main_parts": {
          "type": "array",
          "items": {"$ref": "#/$defs/part"}
        },
        "subquestions": {
          "type": "array",
          "items": {"$ref": "#/$defs/subquestion"}
        },
        "starts_on_previous_page": {"type": "boolean"},
        "continues_next_page": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "answer_type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "short_answer",
        "descriptive",
        "true_false",
        "mixed",
        "unknown"
      ]
    },
    "ignored_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "bbox"],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "header",
            "footer",
            "page_number",
            "chapter_title",
            "decoration",
            "excluded_fill_blank_drill",
            "solution_content",
            "next_question"
          ]
        },
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    }
  }
}
