{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Independent Studio document v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","document_id","revision","created_at","updated_at","origin","imports","content","groups","assets","styles","layout","output_role"],
  "properties":{
    "schema_version":{"const":1},"document_id":{"$ref":"#/$defs/uuid"},"revision":{"type":"integer","minimum":1},
    "created_at":{"$ref":"#/$defs/utc"},"updated_at":{"$ref":"#/$defs/utc"},
    "origin":{"type":"object","additionalProperties":false,"required":["set_id","set_revision"],"properties":{"set_id":{"type":"string","pattern":"^set-[A-Za-z0-9._-]+$","maxLength":128},"set_revision":{"type":"integer","minimum":1}}},
    "imports":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/import"}},
    "content":{"type":"object","additionalProperties":false,"required":["roots","nodes"],"properties":{"roots":{"$ref":"#/$defs/ids"},"nodes":{"type":"array","maxItems":30000,"items":{"$ref":"#/$defs/node"}}}},
    "groups":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/group"}},
    "assets":{"type":"array","maxItems":3000,"items":{"$ref":"#/$defs/asset"}},
    "styles":{"type":"object","additionalProperties":false,"required":["defaults","node_overrides"],"properties":{"defaults":{"allOf":[{"$ref":"#/$defs/style"},{"required":["font_family","font_size_pt","line_spacing","paragraph_spacing_mm"]}]},"node_overrides":{"type":"object","propertyNames":{"$ref":"#/$defs/uuid"},"additionalProperties":{"$ref":"#/$defs/style"}}}},
    "layout":{"$ref":"#/$defs/layout"},"output_role":{"enum":["question_only","explanation_only","combined_end_section"]}
  },
  "$defs":{
    "uuid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "utc":{"type":"string","format":"date-time","pattern":"Z$"},
    "ids":{"type":"array","uniqueItems":true,"maxItems":30000,"items":{"$ref":"#/$defs/uuid"}},
    "string":{"type":"string","maxLength":16384},
    "empty":{"type":"object","additionalProperties":false},
    "provenance":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["snapshot_id","original_pointer"],"properties":{"snapshot_id":{"$ref":"#/$defs/uuid"},"original_pointer":{"type":"string","maxLength":2048,"pattern":"^(|/.*)$"}}}]},
    "import":{"type":"object","additionalProperties":false,"required":["snapshot_id","project_id","item_id","source_revision","package_sha256","relative_path","asset_bindings"],"properties":{"snapshot_id":{"$ref":"#/$defs/uuid"},"project_id":{"$ref":"#/$defs/id"},"item_id":{"$ref":"#/$defs/id"},"source_revision":{"type":"integer","minimum":1},"package_sha256":{"$ref":"#/$defs/sha"},"relative_path":{"type":"string","pattern":"^imports/[0-9a-f-]{36}\\.json$"},"asset_bindings":{"type":"object","propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"$ref":"#/$defs/uuid"}}}},
    "asset":{"type":"object","additionalProperties":false,"required":["id","role","section","relative_path","mime_type","size","sha256","width_px","height_px"],"properties":{"id":{"$ref":"#/$defs/uuid"},"role":{"type":"string","maxLength":128},"section":{"enum":["question","explanation","shared"]},"relative_path":{"type":"string","pattern":"^assets/[0-9a-f]{64}\\.(png|jpg|webp|gif)$"},"mime_type":{"enum":["image/png","image/jpeg","image/webp","image/gif"]},"size":{"type":"integer","minimum":1,"maximum":20971520},"sha256":{"$ref":"#/$defs/sha"},"width_px":{"type":"integer","minimum":1,"maximum":30000},"height_px":{"type":"integer","minimum":1,"maximum":30000}}},
    "group":{"type":"object","additionalProperties":false,"required":["id","source_key","common_node_ids","child_question_ids"],"properties":{"id":{"$ref":"#/$defs/uuid"},"source_key":{"type":"string","minLength":1,"maxLength":512},"common_node_ids":{"$ref":"#/$defs/ids"},"child_question_ids":{"allOf":[{"$ref":"#/$defs/ids"},{"minItems":1}]}}},
    "style":{"type":"object","additionalProperties":false,"properties":{"font_family":{"enum":["Noto Sans KR","Noto Serif KR"]},"font_size_pt":{"type":"number","minimum":6,"maximum":72},"line_spacing":{"type":"number","minimum":0.8,"maximum":4},"paragraph_spacing_mm":{"type":"number","minimum":0,"maximum":50},"bold":{"type":"boolean"},"italic":{"type":"boolean"},"underline":{"type":"boolean"},"align":{"enum":["left","center","right"]},"math_size":{"type":"number","minimum":0.5,"maximum":3},"math_variant":{"enum":["normal","bold"]}}},
    "layout":{"type":"object","additionalProperties":false,"required":["template","paper","width_mm","height_mm","margins_mm","columns","column_gap_mm","question_gap_mm","break_before","first_page","title","instructions","unit","type","header","footer","page_start","cover_number_visible","context_repeats"],"properties":{
      "template":{"enum":["mock_exam","workbook"]},"paper":{"enum":["A4","B4","custom"]},"width_mm":{"type":"number","minimum":100,"maximum":500},"height_mm":{"type":"number","minimum":100,"maximum":700},
      "margins_mm":{"type":"object","additionalProperties":false,"required":["top","right","bottom","left"],"properties":{"top":{"type":"number","minimum":0,"maximum":100},"right":{"type":"number","minimum":0,"maximum":100},"bottom":{"type":"number","minimum":0,"maximum":100},"left":{"type":"number","minimum":0,"maximum":100}}},
      "columns":{"const":2},"column_gap_mm":{"type":"number","minimum":0,"maximum":100},"question_gap_mm":{"type":"number","minimum":0,"maximum":100},"break_before":{"$ref":"#/$defs/ids"},"first_page":{"enum":["title_questions","cover"]},
      "title":{"$ref":"#/$defs/string"},"instructions":{"$ref":"#/$defs/string"},"unit":{"$ref":"#/$defs/string"},"type":{"$ref":"#/$defs/string"},"header":{"$ref":"#/$defs/string"},"footer":{"$ref":"#/$defs/string"},"page_start":{"type":"integer","minimum":1,"maximum":9999},"cover_number_visible":{"type":"boolean"},
      "context_repeats":{"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["group_id","page","column","before_question_id"],"properties":{"group_id":{"$ref":"#/$defs/uuid"},"page":{"type":"integer","minimum":1,"maximum":200},"column":{"enum":[1,2]},"before_question_id":{"$ref":"#/$defs/uuid"}}}}
    }},
    "question":{"type":"object","additionalProperties":false,"required":["label","selected","diagnostics"],"properties":{"label":{"$ref":"#/$defs/string"},"selected":{"type":"boolean"},"diagnostics":{"type":"array","items":{"$ref":"#/$defs/string"}}}},
    "paragraph":{"type":"object","additionalProperties":false,"required":["role"],"properties":{"role":{"type":"string","maxLength":128}}},
    "text":{"type":"object","additionalProperties":false,"required":["text","marks"],"properties":{"text":{"$ref":"#/$defs/string"},"marks":{"type":"array","uniqueItems":true,"items":{"enum":["bold","italic","underline","superscript","subscript"]}}}},
    "equation":{"type":"object","additionalProperties":false,"required":["authority","latex","hwp_script","plain_text","display","validation","derivation"],"properties":{"authority":{"enum":["ordinary_tex","native_hwp_only","manual_disagreement","plain_only","plain_literal","unsupported_tex"]},"latex":{"type":["string","null"],"maxLength":16384},"hwp_script":{"type":["string","null"],"maxLength":16384},"plain_text":{"type":["string","null"],"maxLength":16384},"display":{"enum":["inline","display"]},"validation":{"enum":["unverified","valid","unsupported"]},"derivation":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["latex_sha256","converter_version","status","diagnostics"],"properties":{"latex_sha256":{"$ref":"#/$defs/sha"},"converter_version":{"type":"string","minLength":1},"status":{"enum":["derived","review","unsupported"]},"diagnostics":{"type":"array","items":{"type":"string"}}}}]}}},
    "figure":{"type":"object","additionalProperties":false,"required":["asset_id","alt_text","role","width_mm","height_mm","keep_aspect"],"properties":{"asset_id":{"$ref":"#/$defs/uuid"},"alt_text":{"$ref":"#/$defs/string"},"role":{"type":"string","maxLength":128},"width_mm":{"type":"number","minimum":1,"maximum":400},"height_mm":{"type":["number","null"],"minimum":1,"maximum":600},"keep_aspect":{"type":"boolean"}}},
    "table":{"type":"object","additionalProperties":false,"required":["column_count","semantic_type"],"properties":{"column_count":{"type":"integer","minimum":1,"maximum":100},"semantic_type":{"type":"string","maxLength":128}}},
    "cell":{"type":"object","additionalProperties":false,"required":["role","row_span","col_span"],"properties":{"role":{"type":"string","maxLength":128},"row_span":{"type":"integer","minimum":1,"maximum":100},"col_span":{"type":"integer","minimum":1,"maximum":100}}},
    "box":{"type":"object","additionalProperties":false,"required":["role","title","title_visible","source_layout"],"properties":{"role":{"type":"string","maxLength":128},"title":{"$ref":"#/$defs/string"},"title_visible":{"type":"boolean"},"source_layout":{"type":["string","null"],"maxLength":128}}},
    "choice":{"type":"object","additionalProperties":false,"required":["label","choice_id"],"properties":{"label":{"$ref":"#/$defs/string"},"choice_id":{"$ref":"#/$defs/id"}}},
    "answer":{"type":"object","additionalProperties":false,"required":["kind","label","text","choice_ids","value","part_id"],"properties":{"kind":{"enum":["choice","content","true_false","composite","unknown","text"]},"label":{"type":["string","null"],"maxLength":16384},"part_id":{"type":["string","null"],"maxLength":128},"text":{"type":["string","null"],"maxLength":16384},"choice_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"value":{"type":["boolean","null"]}}},
    "node":{"type":"object","additionalProperties":false,"required":["id","kind","children","payload","provenance"],"properties":{"id":{"$ref":"#/$defs/uuid"},"kind":{"enum":["question","paragraph","text","equation","figure","table","row","cell","box","choice","answer","explanation","line_break"]},"children":{"$ref":"#/$defs/ids"},"payload":{"type":"object"},"provenance":{"$ref":"#/$defs/provenance"}},"allOf":[
      {"if":{"properties":{"kind":{"const":"question"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/question"}}}},
      {"if":{"properties":{"kind":{"const":"paragraph"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/paragraph"}}}},
      {"if":{"properties":{"kind":{"const":"text"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/text"}}}},
      {"if":{"properties":{"kind":{"const":"equation"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/equation"}}}},
      {"if":{"properties":{"kind":{"const":"figure"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/figure"}}}},
      {"if":{"properties":{"kind":{"const":"table"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/table"}}}},
      {"if":{"properties":{"kind":{"const":"cell"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/cell"}}}},
      {"if":{"properties":{"kind":{"const":"box"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/box"}}}},
      {"if":{"properties":{"kind":{"const":"choice"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/choice"}}}},
      {"if":{"properties":{"kind":{"const":"answer"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/answer"}}}},
      {"if":{"properties":{"kind":{"enum":["row","explanation","line_break"]}}},"then":{"properties":{"payload":{"$ref":"#/$defs/empty"}}}}
    ]}
  }
}
