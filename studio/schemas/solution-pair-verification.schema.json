{
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id", "selected_asset_id", "same_question", "content_match", "number_consistency", "answer_consistency", "crop_complete", "neighbor_content_absent", "crop_repair", "confidence", "evidence", "issues"],
  "properties": {
    "item_id": {"type": "string"},
    "selected_asset_id": {"type": "string"},
    "same_question": {"enum": ["match", "mismatch", "uncertain"]},
    "content_match": {"enum": ["match", "mismatch", "uncertain"]},
    "number_consistency": {"enum": ["match", "source_number_issue", "mismatch", "unknown"]},
    "answer_consistency": {"enum": ["match", "conflict", "not_available"]},
    "crop_complete": {"type": "boolean"},
    "neighbor_content_absent": {"type": "boolean"},
    "crop_repair": {"anyOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false,
       "required": ["image_index", "edge", "visible_evidence", "confidence"],
       "properties": {
         "image_index": {"const": 1},
         "edge": {"enum": ["top", "bottom", "left", "right"]},
         "visible_evidence": {"type": "string", "minLength": 2},
         "confidence": {"type": "number", "minimum": 0.9, "maximum": 1}
       }}
    ]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "issues": {"type": "array", "items": {"type": "string"}}
  }
}
